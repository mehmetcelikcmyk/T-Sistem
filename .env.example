# ═══════════════════════════════════════════════════════════════════════════
# T-SISTEM · ORTAM DEGISKENLERI SABLONU
# ═══════════════════════════════════════════════════════════════════════════
# Bu dosyayi `.env` olarak kopyalayip degerleri doldurunuz.
# `.env` ASLA depoya commit edilmez (.gitignore kapsaminda).
#
# UYARI: Onceki `.env` dosyasi depo icinde canli anahtarlarla birlikte
# dagitilmisti. Asagidaki tum anahtarlar IPTAL EDILIP YENIDEN URETILMELIDIR.
# ═══════════════════════════════════════════════════════════════════════════

# ── Cloudflare D1 ──────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=                    # yetki: D1:Edit + Workers R2 Storage:Edit

# ── Cloudflare R2 ──────────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_BUCKET_NAME=t-sistem
# Custom domain tanimliysa buraya yaziniz (or. https://dosya.tsistem.org).
# Bos birakilirsa sistem otomatik olarak presigned URL uretir.
CLOUDFLARE_R2_PUBLIC_URL=

# ── Veri katmani ───────────────────────────────────────────────────────────
TSISTEM_DB_BACKEND=d1                    # d1 | sqlite
TSISTEM_DB_PATH=data/tsistem.db          # yalnizca sqlite modunda kullanilir

# ── Kimlik dogrulama ───────────────────────────────────────────────────────
# Uretin: python -c "import secrets;print(secrets.token_urlsafe(48))"
TSISTEM_JWT_SECRET=
TSISTEM_OAUTH_REDIRECT=http://localhost:8501
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Ilk yonetici hesabi — YALNIZCA ilk kurulumda 1 yapiniz, sonra 0'a cekiniz.
TSISTEM_BOOTSTRAP=0
TSISTEM_ADMIN_EMAIL=
TSISTEM_ADMIN_PASSWORD=                  # en az 12 karakter
TSISTEM_ADMIN_NAME=Sistem
TSISTEM_ADMIN_SURNAME=Yoneticisi

# ── LLM saglayicilari (virgulle coklu anahtar destekli) ────────────────────
ANTHROPIC_API_KEYS=
GROQ_API_KEYS=
OPENAI_API_KEYS=
TSISTEM_LLM_ORDER=anthropic,groq,openai
TSISTEM_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
TSISTEM_GROQ_MODEL=llama-3.3-70b-versatile
TSISTEM_OPENAI_MODEL=gpt-4o-mini

# ── Benzerlik / intihal (hibrit) ───────────────────────────────────────────
TSISTEM_SIMILARITY_MODE=hybrid           # literal | semantic | hybrid
CLOUDFLARE_VECTORIZE_INDEX=t-sistem-raporlar
TSISTEM_EMBEDDING_MODEL=@cf/baai/bge-m3

# ── API ────────────────────────────────────────────────────────────────────
T_SISTEM_API=http://localhost:8000/api
CORS_ALLOWED_ORIGINS=http://localhost:8501

# ── E-posta (sifre sifirlama / bildirim) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
